# Build-time credentials for task-runner.
#
#   cp secrets.env.template secrets.env   # then fill in the values
#   set -a; source secrets.env; set +a
#   cargo build --release
#
# The values are embedded into the compiled binary (env! at compile time);
# the build fails if any of them is missing. secrets.env is git-ignored.

# Pastebin (https://pastebin.com/doc_api)
export PASTEBIN_DEV_KEY=""
export PASTEBIN_USER_NAME=""
export PASTEBIN_USER_PASSWORD=""

# Telegram bot
export TELEGRAM_TOKEN=""
export TELEGRAM_CHAT_ID=""   # integer

# LLM used to explain failed runs. Any OpenAI-compatible provider works; it is
# selected by the base URL, which must include the version prefix (the client
# appends /chat/completions). Leave OPENAI_BASE_URL empty to disable summaries.
#   OpenAI:  https://api.openai.com/v1
export OPENAI_BASE_URL=""
export OPENAI_API_KEY=""
export OPENAI_MODEL="qwen3-coder-next"
